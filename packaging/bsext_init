#!/bin/bash
### BEGIN INIT INFO
# Provides:          bsext-argus-rtsp
# Required-Start:    $remote_fs $syslog
# Required-Stop:     $remote_fs $syslog
# Default-Start:     2 3 4 5
# Default-Stop:      0 1 6
# Short-Description: BrightSign Argus RTSP Watcher Extension
# Description:       Runs the argus-rtsp-watcher Go supervisor, which owns
#                     mosquitto and all per-stream engine processes.
### END INIT INFO

# Source function library if it exists
[ -f /etc/init.d/functions ] && . /etc/init.d/functions

SCRIPT_PATH=$(dirname $(realpath $0))

DAEMON_NAME="bsext-argus-rtsp"
PIDFILE="/var/run/${DAEMON_NAME}.pid"

# defaults -- these can be overridden by the registry
DISABLE_AUTO_START=false

# Common setup function to determine SOC model
get_soc_name() {
    # figure out the SOC model -- default to RK3588
    SOC_NAME=RK3588
    if [ -f /sys/firmware/devicetree/base/compatible ]; then
        # Use strings command to handle null bytes in devicetree properly
        COMPATIBLE=$(strings /sys/firmware/devicetree/base/compatible 2>/dev/null)

        # Look for rockchip,rk3588 pattern in the compatible string
        if echo "$COMPATIBLE" | grep -q "rockchip,rk3588"; then
            SOC_NAME="RK3588"
        fi

        # Look for rockchip,rk3576 pattern in the compatible string
        if echo "$COMPATIBLE" | grep -q "rockchip,rk3576"; then
            SOC_NAME="RK3576"
        fi

        # Look for rockchip,rk3568 pattern in the compatible string
        if echo "$COMPATIBLE" | grep -q "rockchip,rk3568"; then
            SOC_NAME="RK3568"
        fi
    else
        # In development environments or non-XT5 hardware, default to RK3588
        echo "WARNING: Unable to determine SOC model, defaulting to RK3588 for development" >&2
    fi

    # Return the SOC model
    echo "${SOC_NAME}"
}

setup_gstreamer_env() {
    echo "Setting up GStreamer environment for SOC: $SOC_NAME"

    # CRITICAL: Bundled plugins MUST come FIRST
    # ext-bundle includes RTSP plugins + libgstcoreelements.so (queue)
    # All plugins are from same GStreamer version for compatibility
    export GST_PLUGIN_PATH=/var/volatile/bsext/ext_npu_argus_rtsp/$SOC_NAME/lib/gstreamer-1.0:/usr/lib/gstreamer-1.0
    export GST_PLUGIN_SYSTEM_PATH=$GST_PLUGIN_PATH

    # Include MQTT bin directory first so mosquitto utilities find their libraries
    # Also include bin directory for all other shared libraries
    export LD_LIBRARY_PATH=/var/volatile/bsext/ext_npu_argus_rtsp/$SOC_NAME/bin:/var/volatile/bsext/ext_npu_argus_rtsp/$SOC_NAME/lib:/usr/lib:$LD_LIBRARY_PATH
    export GST_REGISTRY="/tmp/gst-registry.bin"
    export GST_PLUGIN_SCANNER="/usr/libexec/gstreamer-1.0/gst-plugin-scanner"
    export GST_REGISTRY_REUSE_PLUGIN_SCANNER=1
    export GST_DEBUG_NO_COLOR=1

    # Force GStreamer to rescan plugins by clearing old registry
    rm -f /tmp/gst-registry.bin
    echo "  Cleared GStreamer registry - will rescan plugins on startup"
    echo "  GST_PLUGIN_PATH=$GST_PLUGIN_PATH"
    echo "  GST_PLUGIN_SYSTEM_PATH=$GST_PLUGIN_SYSTEM_PATH"
    echo "  LD_LIBRARY_PATH=$LD_LIBRARY_PATH"
    echo "  GST_REGISTRY=$GST_REGISTRY"
    echo "  GST_PLUGIN_SCANNER=$GST_PLUGIN_SCANNER"
    echo "  GST_REGISTRY_REUSE_PLUGIN_SCANNER=$GST_REGISTRY_REUSE_PLUGIN_SCANNER"
    echo "  MQTT utilities available in: /var/volatile/bsext/ext_npu_argus_rtsp/$SOC_NAME/bin/"
}

# Run the watcher supervisor. It owns mosquitto and every per-stream engine
# process itself, so there is nothing else to launch here.
run_watcher() {
    # Default to running in foreground
    local background=$1

    SOC_NAME=$(get_soc_name)
    SOC_HOME=${SCRIPT_PATH}/${SOC_NAME}
    WATCHER_BIN=${SOC_HOME}/watcher

    cd ${SOC_HOME}

    # No CLI arguments: the watcher discovers watcher.json itself (SD/SSD,
    # then the package default alongside this binary).
    if [ "$background" = "true" ]; then
        echo "DEBUG: Starting watcher as a daemon"
        echo "DEBUG: Executable: ${WATCHER_BIN}"

        # LD_LIBRARY_PATH/GST_* are already set by setup_gstreamer_env, and
        # the watcher inherits this environment (and passes it on to the
        # mosquitto child it launches).
        ${WATCHER_BIN} >> /tmp/watcher.log 2>&1 &
        WATCHER_PID=$!
        echo $WATCHER_PID > ${PIDFILE}
        echo "DEBUG: watcher PID=${WATCHER_PID}"
    else
        echo "DEBUG: Running watcher in foreground"
        echo "DEBUG: Executable: ${WATCHER_BIN}"
        exec ${WATCHER_BIN}
    fi
}

do_start() {
    # check registry for auto-start
    reg_disable_auto_start=$(registry extension ${DAEMON_NAME}-disable-auto-start)
    if [ -n "${reg_disable_auto_start}" ]; then
        DISABLE_AUTO_START=${reg_disable_auto_start}
    fi

    if [ "${DISABLE_AUTO_START}" = "true" ]; then
        echo "Auto-start is disabled for ${DAEMON_NAME}"
        return
    fi

    # Refuse to start a second watcher on top of a live one: it would
    # orphan the running watcher (still holding mosquitto's port and the
    # camera/NPU) and spawn a second process that only contends with it.
    if [ -f "${PIDFILE}" ]; then
        local existing_pid=$(cat ${PIDFILE} 2>/dev/null)
        if [ -n "$existing_pid" ] && kill -0 $existing_pid 2>/dev/null; then
            echo "watcher already running (PID $existing_pid); use restart to reload"
            return
        fi
    fi

    # No live watcher found -- clean up a stale PID file left behind by an
    # unclean shutdown. The watcher owns mosquitto and every engine
    # process, so there is nothing else to kill or clean up here.
    rm -f ${PIDFILE} 2>/dev/null || true

    SOC_NAME=$(get_soc_name)
    setup_gstreamer_env

    run_watcher true
}

do_stop() {
    echo "Stopping ${DAEMON_NAME}..."

    if [ ! -f "${PIDFILE}" ]; then
        echo "  No PID file found at ${PIDFILE}; watcher may not be running"
        return
    fi

    local pid=$(cat ${PIDFILE} 2>/dev/null)
    rm -f ${PIDFILE}

    if [ -z "$pid" ]; then
        echo "  PID file was empty, nothing to stop"
        return
    fi

    # SIGTERM tells the watcher to shut down gracefully: it stops its
    # engines and mosquitto, then exits. No kill-by-name here -- the
    # watcher is the only process this script tracks.
    echo "  Sending SIGTERM to watcher (PID $pid)"
    kill -TERM $pid 2>/dev/null || true

    local retry_count=0
    local max_retries=10
    while [ $retry_count -lt $max_retries ]; do
        if ! kill -0 $pid 2>/dev/null; then
            echo "  watcher stopped successfully"
            break
        fi
        sleep 1
        retry_count=$((retry_count + 1))
    done

    if kill -0 $pid 2>/dev/null; then
        echo "  WARNING: watcher still running after ${max_retries}s, sending SIGKILL"
        kill -9 $pid 2>/dev/null || true
    fi

    echo "Stop complete"
}

ACTION=$1

# Default to help if no action specified
if [ -z "$ACTION" ]; then
    ACTION="help"
fi

case "$ACTION" in
    start)
        echo "Starting ${DAEMON_NAME}"
        do_start
        ;;
    stop)
        echo "Stopping ${DAEMON_NAME}"
        do_stop
        ;;
    restart)
        echo "Restarting ${DAEMON_NAME}"
        do_stop
        do_start
        ;;
    run)
        echo "Running ${DAEMON_NAME} in foreground"
        SOC_NAME=$(get_soc_name)
        setup_gstreamer_env
        run_watcher false
        ;;
    help|*)
        echo "Usage: $0 {start|stop|restart|run}"
        echo ""
        echo "Actions:"
        echo "  start     Start the watcher supervisor as a daemon"
        echo "  stop      Stop the watcher supervisor (SIGTERM, graceful)"
        echo "  restart   Restart the watcher supervisor"
        echo "  run       Run the watcher supervisor in foreground"
        echo ""
        echo "Configuration via BrightSign registry:"
        echo "  bsext-argus-rtsp-disable-auto-start  Disable automatic startup (true/false)"
        echo ""
        echo "The watcher owns mosquitto and every per-stream engine process;"
        echo "this script only starts, stops, and monitors the single watcher"
        echo "process. Streams are configured via watcher.json (see docs)."
        echo ""
        echo "MQTT Utilities:"
        echo "  The environment is configured with LD_LIBRARY_PATH for MQTT utilities."
        echo "  You can run MQTT commands from any directory:"
        echo ""
        echo "  mosquitto_sub -h 127.0.0.1 -p 1883 -t 'bs/argus/#' -v"
        echo "  mosquitto_pub -h 127.0.0.1 -p 1883 -t 'test/topic' -m 'message'"
        echo ""
        echo "  # To view current settings:"
        echo "  registry read extension bsext-argus-rtsp-disable-auto-start"
        exit 1
        ;;
esac

exit 0
