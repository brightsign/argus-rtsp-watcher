GO ?= go
WATCHER_BIN := build/watcher
TARGET_SOC ?= rk3588
ENGINE_BUILD_DIR := build/$(TARGET_SOC)
ENGINE_BIN := $(ENGINE_BUILD_DIR)/argus-engine
ENGINE_TEST_BUILD_DIR := build/host-tests
ENGINE_TEST_BIN := $(ENGINE_TEST_BUILD_DIR)/tests/run_engine_tests
IMAGE_SERVER_BIN := build/image-stream-server
MOSQUITTO_DIR := build/mosquitto
LIBS_DIR := build/libs
# Optional: path to the BrightSign cobra toolchain installer. If empty, fetch-sdk
# searches the shared cache dir / repo root / CWD for
# brightsign-x86_64-cobra-toolchain-*.sh.
SDK_INSTALLER ?=

# Shared build cache (SDK + RKNN toolkit clone + compiled models) lives OUTSIDE
# the repo so it is downloaded/built once and reused across projects. Override
# the location with ARGUS_CACHE_DIR (default: ../argus-build-cache, parallel to
# this repo). scripts/lib/cache.sh is the single source of truth -- the shell-outs
# below ask it for the resolved absolute paths so Make and the scripts agree.
# ARGUS_CACHE_DIR is forwarded explicitly: a command-line override is a Make
# variable, not an env var, so $(shell ...) would not otherwise see it.
CACHE_SH := ARGUS_CACHE_DIR='$(ARGUS_CACHE_DIR)' bash scripts/lib/cache.sh print
CACHE_DIR := $(shell $(CACHE_SH) cache)
SDK_DIR := $(shell $(CACHE_SH) sdk)
SDK_ENV := $(shell $(CACHE_SH) sdk-env)
TOOLKIT_DIR := $(shell $(CACHE_SH) toolkit)
MODELS_DIR := $(shell $(CACHE_SH) models)
# Ensure the recipe scripts (which source cache.sh themselves) resolve the same
# location, including when ARGUS_CACHE_DIR was given on the command line.
export ARGUS_CACHE_DIR

# Packaging: the engine, mosquitto broker, runtime libs, and image-stream-server
# are all generic aarch64 (same for every SoC), so each is built once and staged
# into every per-SoC directory. Only the .rknn models are SoC-specific. Every
# runtime asset is produced on demand from upstream sources (build-mosquitto,
# build-libs, build-models, build-image-server) or the SDK sysroot -- this repo
# has no dependency on a sibling argus install tree.
SOC_LIST := RK3588 RK3576 RK3568
STAGING_DIR := staging
EXT_NAME := npu_argus_rtsp
BUILD_TS := $(shell date +%s)
DEV_ZIP := argus-rtsp-watcher-$(BUILD_TS).zip
EXT_ZIP := argus-rtsp-watcher-ext-$(BUILD_TS).zip

# Deploy helper: `make copy` scp's the most recent *.zip to a target player.
# Set BS_PLAYER (host/ip) and BS_PASSWORD (SSH password) in .envrc (gitignored;
# see envrc-example). Override the file to copy with ZIP=<path>.
PLAYER_USER ?= brightsign
PLAYER_DEST ?= /storage/sd
ZIP ?= $(shell ls -t *.zip 2>/dev/null | head -n1)
# On-device install helper, regenerated by `make package` and copied alongside the zip.
INSTALL_HELPER := install-on-player.sh

.DEFAULT_GOAL := help

help:                ## Print available targets
	@grep -E '^[a-zA-Z_-]+:.*?## .*$$' $(MAKEFILE_LIST) | awk 'BEGIN{FS=":.*?## "}{printf "  %-14s %s\n", $$1, $$2}'

build: package       ## Build watcher + engine, stage all SoCs, and package -> zip(s) in repo root

prep:                ## Fetch the Rockchip-origin RKNN headers + runtime into engine/include/ (needs network; not vendored)
	bash scripts/prep.sh

fetch-sdk:           ## Install the aarch64 cross-compile SDK into the shared cache (needs the cobra toolchain installer; pass SDK_INSTALLER=/path or drop it in the cache dir / repo root)
	bash scripts/fetch-sdk.sh $(SDK_INSTALLER)

build-watcher:       ## Cross-compile the Go watcher for arm64
	GOOS=linux GOARCH=arm64 $(GO) build -o $(WATCHER_BIN) ./cmd/watcher

build-image-server:  ## Build the image-stream-server (MJPEG preview) from its upstream repo (needs git + go + network)
	bash scripts/build-image-server.sh $(CURDIR)/$(IMAGE_SERVER_BIN)

build-mosquitto: fetch-sdk ## Cross-compile the mosquitto broker + harvest client tools from the SDK sysroot
	bash scripts/build-mosquitto.sh $(CURDIR)/$(MOSQUITTO_DIR)

build-libs: prep fetch-sdk ## Harvest the aarch64 runtime libraries (OpenCV/GStreamer/RGA/RKNN/...) from the SDK sysroot
	bash scripts/build-libs.sh $(CURDIR)/$(LIBS_DIR)

build-models:        ## Compile the RKNN models per SoC from upstream ONNX into the shared cache (needs docker + ~10GB + network)
	bash scripts/build-models.sh $(MODELS_DIR) $(SOC_LIST)

build-engine: prep fetch-sdk ## Cross-compile the C++ engine for TARGET_SOC (default rk3588)
	mkdir -p $(ENGINE_BUILD_DIR)
	bash -c 'source $(SDK_ENV) && \
		cmake -S $(CURDIR)/engine -B $(CURDIR)/$(ENGINE_BUILD_DIR) \
			-DOECORE_TARGET_SYSROOT="$$OECORE_TARGET_SYSROOT" \
			-DTARGET_SOC=$(TARGET_SOC) -DBUILD_TESTS=OFF && \
		$(MAKE) -C $(CURDIR)/$(ENGINE_BUILD_DIR) -j$$(nproc)'

build-engine-tests: prep ## Build the C++ engine unit tests for the host (native, not cross-compiled)
	mkdir -p $(ENGINE_TEST_BUILD_DIR)
	cmake -S $(CURDIR)/engine -B $(CURDIR)/$(ENGINE_TEST_BUILD_DIR) -DBUILD_TESTS=ON
	$(MAKE) -C $(CURDIR)/$(ENGINE_TEST_BUILD_DIR) run_engine_tests -j$$(nproc)

run-engine-tests: build-engine-tests ## Build and run the C++ engine unit tests
	$(ENGINE_TEST_BIN)

package: build-watcher build-engine build-image-server build-mosquitto build-libs build-models ## Assemble staging/<SOC> for rk3588/rk3576/rk3568 and produce the dev + LVM extension zips
	SOC_LIST="$(SOC_LIST)" STAGING_DIR="$(STAGING_DIR)" \
		WATCHER_BIN="$(CURDIR)/$(WATCHER_BIN)" ENGINE_BIN="$(CURDIR)/$(ENGINE_BIN)" \
		IMAGE_SERVER_BIN="$(CURDIR)/$(IMAGE_SERVER_BIN)" \
		MOSQUITTO_DIR="$(CURDIR)/$(MOSQUITTO_DIR)" LIBS_DIR="$(CURDIR)/$(LIBS_DIR)" MODELS_DIR="$(MODELS_DIR)" \
		EXT_NAME="$(EXT_NAME)" DEV_ZIP="$(DEV_ZIP)" EXT_ZIP="$(EXT_ZIP)" \
		INSTALL_HELPER="$(INSTALL_HELPER)" PLAYER_DEST="$(PLAYER_DEST)" \
		scripts/build.sh

test: run-tests      ## Alias for run-tests

run-tests: run-engine-tests ## Run all Go tests + engine unit tests
	$(GO) test ./...

run-integration-tests: ## Run hardware/engine integration tests (needs `make build` staged assets; skips cleanly off-target)
	$(GO) test -tags integration -v ./test/...

clean:               ## Remove this repo's build artifacts (build/, staging/, zips, install helper, fetched prep headers); leaves the shared cache
	rm -rf build staging *.zip $(INSTALL_HELPER)
	bash scripts/prep.sh clean 2>/dev/null || true
	@echo "Note: the shared build cache is left intact ($(CACHE_DIR))."
	@echo "      Run 'make cache-clean' to remove it (affects all projects)."

copy:                ## scp the most recent *.zip to the player (needs BS_PLAYER + BS_PASSWORD; override ZIP=<path>)
	@test -n "$(BS_PLAYER)" || { echo "ERROR: BS_PLAYER not set -- copy envrc-example to .envrc and fill it in (then 'direnv allow' or 'source .envrc')"; exit 1; }
	@test -n "$(BS_PASSWORD)" || { echo "ERROR: BS_PASSWORD not set -- see envrc-example"; exit 1; }
	@test -n "$(ZIP)" || { echo "ERROR: no *.zip found in repo root -- run 'make build' first"; exit 1; }
	@command -v sshpass >/dev/null 2>&1 || { echo "ERROR: sshpass not installed -- 'sudo apt install sshpass'"; exit 1; }
	@test -f "$(INSTALL_HELPER)" || echo "WARNING: $(INSTALL_HELPER) not found (run 'make build'); copying zip only"
	@echo "Copying $(ZIP) + $(INSTALL_HELPER) -> $(PLAYER_USER)@$(BS_PLAYER):$(PLAYER_DEST)/"
	@# NOTE: no `scp -O`. The player's SSH login is the BrightSign REPL, not a Unix
	@# shell; legacy SCP (-O) runs `scp -t` through that REPL and fails with
	@# "Unknown command: -c scp -t". Default scp uses the SFTP subsystem, which
	@# dropbear serves independently of the REPL, so it works.
	@# No `scp -p`: /storage/sd is a FAT mount, so the post-transfer fsetstat fails
	@# with "remote fsetstat: Permission denied". The leading `sshpass -p` is the
	@# password flag, unrelated. &&-chained so a real transfer failure fails `make copy`.
	sshpass -p "$(BS_PASSWORD)" scp -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null "$(ZIP)" $(wildcard $(INSTALL_HELPER)) "$(PLAYER_USER)@$(BS_PLAYER):$(PLAYER_DEST)/" && \
		echo "Copied. On the player's root shell (Ctrl-C,Enter -> exit -> exit), run:  sh $(PLAYER_DEST)/$(INSTALL_HELPER)   (reboots on success; stays in the shell on failure)"

cache-info:          ## Show the resolved shared-cache location and what is present
	@echo "ARGUS_CACHE_DIR : $(if $(ARGUS_CACHE_DIR),$(ARGUS_CACHE_DIR) (override),(unset -> default))"
	@echo "cache   : $(CACHE_DIR)"
	@echo "sdk     : $(SDK_DIR)  [$(if $(wildcard $(SDK_ENV)),present,absent)]"
	@echo "toolkit : $(TOOLKIT_DIR)  [$(if $(wildcard $(TOOLKIT_DIR)),present,absent)]"
	@echo "models  : $(MODELS_DIR)  [$(if $(wildcard $(MODELS_DIR)),present,absent)]"
	@docker image inspect rknn_tk2 >/dev/null 2>&1 \
		&& echo "docker  : rknn_tk2 image  [present]" \
		|| echo "docker  : rknn_tk2 image  [absent]"

cache-clean:         ## Remove the ENTIRE shared build cache (SDK + toolkit + models) -- AFFECTS ALL PROJECTS using it
	@echo "Removing the shared cache used by every project: $(CACHE_DIR)"
	rm -rf "$(CACHE_DIR)"
	@echo "Shared cache removed. The rknn_tk2 Docker image is left intact; remove it with: docker rmi rknn_tk2"

.PHONY: help build prep copy cache-info cache-clean fetch-sdk build-watcher build-image-server build-mosquitto build-libs build-models build-engine build-engine-tests run-engine-tests package test run-tests run-integration-tests clean
